{
  "name": "agent-tape",
  "version": "0.1.0",
  "description": "Deterministic record-and-replay test harness for LLM agent loops and tool-calling workflows without external API calls.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js"
  },
  "keywords": [
    "llm",
    "agent",
    "testing",
    "tape",
    "vcr",
    "replay",
    "mock"
  ],
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  }
}
